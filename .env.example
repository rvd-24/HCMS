# --- Prescript web app ---
PRESCRIPT_JWT_SECRET=change-me-to-a-long-random-string
# Empty = local SQLite at data/prescript.db. For Supabase use the *session pooler*
# URI (Connect → Session pooler); postgresql:// is mapped to the psycopg driver.
# PRESCRIPT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# PRESCRIPT_CORS_ORIGINS=http://localhost:5173

# Uploaded files (prescriptions, X-rays). All three set = a PRIVATE Supabase Storage
# bucket (Storage → New bucket, "Public" off, no policies needed); empty = data/uploads.
# Use the secret / service_role key (Project Settings → API Keys) — backend only, never
# the frontend. Files are served through the authenticated API, never by bucket URL.
# PRESCRIPT_SUPABASE_URL=https://<project-ref>.supabase.co
# PRESCRIPT_SUPABASE_SERVICE_KEY=
# PRESCRIPT_STORAGE_BUCKET=

# Logins. `uv run prescript setup` creates them and, when a password is set
# here, resets the existing admin / seeded doctor logins to it (this overrides
# passwords changed in the app). Doctor logins are <first>.<last>@clinic.local.
PRESCRIPT_ADMIN_EMAIL=admin@clinic.local
PRESCRIPT_ADMIN_PASSWORD=
PRESCRIPT_DOCTOR_PASSWORD=
# Fallback for new logins when the above are empty (random if this is empty too).
# PRESCRIPT_SEED_PASSWORD=
CLINIC_NAME=Kalinga Institute of Dental Sciences (KIDS)
CLINIC_TIMEZONE=Asia/Kolkata
DEFAULT_SLOT_MINUTES=30

# Email is OFF unless true. Calendar invites count as email.
PRESCRIPT_EMAIL_ENABLED=false
# While set, every email goes here instead of real recipients.
PRESCRIPT_EMAIL_REDIRECT=technorvinfo@gmail.com

# --- Extraction: OpenAI (used when OPENAI_API_KEY is set) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# --- Extraction: Azure OpenAI (fallback when OPENAI_API_KEY is empty) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Google (Gmail + Calendar): put credentials.json in secrets/, then `uv run prescript google-auth`

# --- Other channels (optional) ---
SLACK_BOT_TOKEN=
# MS_GRAPH_TENANT_ID= / MS_GRAPH_CLIENT_ID= / MS_GRAPH_CLIENT_SECRET= / MS_GRAPH_SENDER_UPN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

# --- Pharmacy department ---
PHARMACY_EMAIL=technorvinfo@gmail.com
PHARMACY_WHATSAPP_NUMBER=
